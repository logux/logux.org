{
  "name": "logux.org",
  "private": true,
  "homepage": "https://logux.org/",
  "license": "MIT",
  "repository": "logux/logux.org",
  "type": "module",
  "scripts": {
    "start:uikit": "vite --open",
    "test:js": "oxlint",
    "test:build": "pnpm build && size-limit",
    "test": "pnpm run /^test:/",
    "clean": "rm -Rf dist/",
    "build": "NODE_ENV=production ./scripts/build.js",
    "start": "serve dist/"
  },
  "dependencies": {
    "autoprefixer": "^10.6.1",
    "jstransformer-lowlight": "^0.1.0",
    "lowlight": "^3.3.0",
    "nanoevents": "^10.0.0",
    "nanospinner": "^1.2.2",
    "postcss": "^8.5.31",
    "postcss-combine-media-query": "^2.1.0",
    "postcss-hexrgba": "^2.1.0",
    "postcss-media-minmax": "^5.0.0",
    "postcss-mixins": "^12.1.2",
    "postcss-momentum-scrolling": "^3.14.22",
    "postcss-nested": "^9.0.1",
    "postcss-url": "^10.1.4",
    "pug": "^3.0.4",
    "rehype-parse": "^9.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-remark": "^10.0.1",
    "rehype-stringify": "^10.0.1",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "remark-html": "^16.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "remark-stringify": "^11.0.0",
    "slugify": "^1.6.9",
    "sugarss": "^5.0.2",
    "typedoc": "0.28.20",
    "typescript": "~6.0.3",
    "unified": "^11.0.5",
    "unist-util-filter": "^5.0.1",
    "unist-util-flatmap": "^1.0.0",
    "unist-util-visit": "^5.2.0",
    "vite": "^8.3.5",
    "vite-plugin-pug-transformer": "^1.0.8"
  },
  "devDependencies": {
    "@logux/oxc-configs": "^1.2.0",
    "@size-limit/file": "^14.3.0",
    "eslint-plugin-prefer-let": "^4.2.2",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2005",
    "serve": "^14.2.6",
    "size-limit": "^14.3.0",
    "svgo": "^4.1.0"
  },
  "browserslist": [
    "baseline widely available with downstream"
  ],
  "size-limit": [
    {
      "name": "Files to download",
      "path": [
        "dist/uikit/index.html",
        "dist/assets/*.woff2",
        "dist/assets/*.svg",
        "dist/assets/*.js",
        "dist/assets/*.css",
        "!dist/assets/open-*.svg",
        "!dist/assets/close-*.svg",
        "!dist/assets/chat-*.svg",
        "!dist/assets/pinned-*.svg",
        "!dist/assets/favicon-*.svg",
        "!dist/assets/chain-dark-*.svg",
        "!dist/assets/lurkers-dark-*.svg",
        "!dist/assets/logotype-dark-*.svg"
      ],
      "limit": "85 KB"
    },
    {
      "name": "Scripts to execute",
      "path": "dist/assets/*.js",
      "limit": "2 KB"
    }
  ],
  "postcss": {
    "plugins": {
      "postcss-mixins": {
        "mixinsDir": "mixins"
      },
      "postcss-media-minmax": {},
      "postcss-nested": {},
      "postcss-hexrgba": {},
      "postcss-momentum-scrolling": {},
      "autoprefixer": {}
    }
  }
}
